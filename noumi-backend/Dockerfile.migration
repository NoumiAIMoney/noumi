# Multi-stage build for SQLite to PostgreSQL migration tool
FROM golang:1.21-alpine AS builder

# Install build dependencies
RUN apk add --no-cache gcc musl-dev sqlite-dev

# Set working directory
WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./

# Download dependencies
RUN go mod download

# Copy source code
COPY . .

# Build the migration tool
RUN CGO_ENABLED=1 GOOS=linux go build -a -installsuffix cgo -o migrate-sqlite ./cmd/migrate-sqlite

# Final stage
FROM alpine:latest

# Install runtime dependencies
RUN apk add --no-cache ca-certificates sqlite postgresql-client bash

# Create app directory
WORKDIR /app

# Copy the binary from builder stage
COPY --from=builder /app/migrate-sqlite .

# Copy validation script
COPY scripts/validate-migration.sh ./scripts/

# Make scripts executable
RUN chmod +x ./scripts/validate-migration.sh

# Create directory for SQLite database
RUN mkdir -p /data

# Set environment variables
ENV SQLITE_PATH=/data/noumi.db
ENV DATABASE_URL=""

# Create non-root user
RUN addgroup -g 1001 -S appgroup && \
    adduser -u 1001 -S appuser -G appgroup

# Change ownership of app directory
RUN chown -R appuser:appgroup /app /data

# Switch to non-root user
USER appuser

# Default command
CMD ["./migrate-sqlite", "--help"]